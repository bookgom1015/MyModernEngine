<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals"><VCProjectVersion>18.0</VCProjectVersion><WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration"><ConfigurationType>Application</ConfigurationType><UseDebugLibraries>true</UseDebugLibraries><PlatformToolset>v145</PlatformToolset><CharacterSet>Unicode</CharacterSet></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\</RepositoryRoot>
    <OutDir>$(RepositoryRoot)bin\RenderItemsTests\</OutDir>
    <IntDir>$(RepositoryRoot)obj\RenderItemsTests\</IntDir>
    <TargetName>RenderItemsTests</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_D3D12;_DEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp20</LanguageStandard><UseStandardPreprocessor>true</UseStandardPreprocessor><ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(RepositoryRoot)include;$(RepositoryRoot)externs;$(RepositoryRoot)externs\imgui;$(RepositoryRoot)externs\DirectXTK12\Inc;$(RepositoryRoot)externs\DirectXTex\DirectXTex;$(RepositoryRoot)externs\Microsoft.Direct3D.D3D12\build\native\include</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <!-- This executable deliberately links no Engine or Editor library. -->
      <AdditionalDependencies>Renderer.D3D12_Debug.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(RepositoryRoot)lib\Debug;$(RepositoryRoot)lib;$(RepositoryRoot)externs\DirectXTex\DirectXTex\Lib\x64\Debug;$(RepositoryRoot)externs\DirectXTK12\Bin\Desktop_2026\x64\Debug;$(RepositoryRoot)externs\Microsoft.Direct3D.D3D12\build\native\bin\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="RenderItemsTests.cpp" /></ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
